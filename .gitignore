# Python build and cache output
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/

# Virtual environments
.venv/
venv/
env/

# A lock file from a package manager this project does not use. Continuous
# integration installs with pip and `pyproject.toml` names no other tool, so a
# lock file here would pin versions nothing reads. It appears when somebody
# runs the suite under `uv`, which is a choice about a machine rather than
# about the project.
uv.lock

# Test and type checker output
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Run output. A run writes here, and a run is reproducible from its seed, so
# there is nothing in this directory worth keeping in the repository.
runs/

# Editor and operating system
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# A recorded run. The readme documents `rel train --out run.gz` and
# `scripts/check_numbers.py --doc README.md` runs it, so the file lands here.
run.gz
*.rel.gz
